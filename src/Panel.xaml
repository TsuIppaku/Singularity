<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#1C1D24" BorderBrush="#3B3946" BorderThickness="1" CornerRadius="14" Margin="6" Padding="16"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale">
  <Border.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E6E3EC"/><Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/><Setter Property="FontSize" Value="13"/></Style>
    <Style TargetType="ToolTip"><Setter Property="Background" Value="#2B2B35"/><Setter Property="Foreground" Value="#E8E5F1"/><Setter Property="BorderBrush" Value="#44414F"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="9,6"/></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#D9D4E3"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="6,4"/>
      <Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#38323F"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#4C405C"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#B19BCF"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#EEEAF3"/><Setter Property="Background" Value="#17181F"/>
      <Setter Property="CaretBrush" Value="#CBB5FA"/><Setter Property="SelectionBrush" Value="#766396"/>
      <Setter Property="BorderBrush"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#0F1016" Offset="0"/><GradientStop Color="#3C3D49" Offset="1"/></LinearGradientBrush></Setter.Value></Setter><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="9,7"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="InputSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
          <ScrollViewer x:Name="PART_ContentHost"/>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputSurface" Property="BorderBrush" Value="#9B87BD"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Border x:Name="CheckSurface" Background="Transparent" Padding="5" CornerRadius="8">
          <Grid Width="20" Height="20">
            <Rectangle x:Name="CheckBoxOutline" Margin="1" RadiusX="4" RadiusY="4" Stroke="#8F859C" StrokeThickness="1.2" Fill="Transparent"/>
            <Path x:Name="CheckMark" Data="M 1,5 L 4,8 L 10,1" Stroke="#F0EAF8" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/><Setter TargetName="CheckBoxOutline" Property="Fill" Value="#76638D"/><Setter TargetName="CheckBoxOutline" Property="Stroke" Value="#A48ABD"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckSurface" Property="Background" Value="#38323F"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckBoxOutline" Property="Stroke" Value="#D4BCFF"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Border.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="任务计时器" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <Button x:Name="CloseButton" Grid.Column="1" Width="26" Height="26" Padding="0" Foreground="#A69EAE" ToolTip="收起计时器 · Esc" AutomationProperties.Name="收起计时器"/>
    </Grid>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition Width="60"/><ColumnDefinition Width="6"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
      <Grid>
        <TextBox x:Name="TaskNameBox" MaxLength="100" Height="36" AutomationProperties.Name="任务名称" ToolTip="名称可留空，自动使用日期和任务号 · Enter 下一项"/>
        <TextBlock Text="任务名称" FontSize="13" Foreground="#928A9D" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=TaskNameBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </Grid>
      <Grid Grid.Column="2">
        <TextBox x:Name="DurationBox" MaxLength="40" Height="36" HorizontalContentAlignment="Center" AutomationProperties.Name="任务时长" ToolTip="分钟 · 留空为勾选任务 · Enter 加入清单"/>
        <TextBlock Text="min" FontSize="12" Foreground="#928A9D" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=DurationBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </Grid>
      <Button x:Name="AddButton" Grid.Column="4" Height="36" Background="#8065AC" Foreground="White" Padding="0" ToolTip="加入任务清单 · Enter" AutomationProperties.Name="加入任务清单"/>
    </Grid>
    <TextBlock x:Name="ValidationText" Grid.Row="2" Visibility="Collapsed" Foreground="#E5A29B" TextWrapping="Wrap" FontSize="11" Margin="1,8,1,0"/>
    <Border x:Name="AlertCard" Grid.Row="3" Visibility="Collapsed" Background="#293A31" CornerRadius="8" Padding="9,6" Margin="0,12,0,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="AlertName" Foreground="#BFDBC9" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,7,0"/>
        <Button x:Name="AcknowledgeButton" Grid.Column="1" Width="28" Height="28" Padding="0" Foreground="#BFDBC9" ToolTip="知道了 · 停止提醒" AutomationProperties.Name="停止提醒"/>
      </Grid>
    </Border>
    <Grid Grid.Row="4" Margin="1,17,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="PendingHeading" Text="待办 · 0" FontSize="11" Foreground="#9F96AB"/>
      <ContentControl x:Name="SortHint" Grid.Column="1" Width="16" Height="16" ToolTip="按住任务行或左侧手柄拖动排序"/>
    </Grid>
    <ScrollViewer x:Name="RowsScroll" Grid.Row="5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="320" MinHeight="84">
      <ScrollViewer.Resources>
        <Style x:Key="RowsScrollPageButton" TargetType="RepeatButton">
          <Setter Property="Focusable" Value="False"/>
          <Setter Property="IsTabStop" Value="False"/>
          <Setter Property="OverridesDefaultStyle" Value="True"/>
          <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value>
          </Setter>
        </Style>
        <Style TargetType="ScrollBar">
          <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
              <Setter Property="Width" Value="12"/>
              <Setter Property="MinWidth" Value="12"/>
              <Setter Property="MaxWidth" Value="12"/>
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="Focusable" Value="False"/>
              <Setter Property="IsTabStop" Value="False"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ScrollBar">
                    <Grid Width="12" Background="Transparent" SnapsToDevicePixels="True">
                      <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"
                             Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                             ViewportSize="{TemplateBinding ViewportSize}"
                             Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <Track.Resources>
                          <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib"
                                      x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">40</sys:Double>
                        </Track.Resources>
                        <Track.DecreaseRepeatButton>
                          <RepeatButton Style="{StaticResource RowsScrollPageButton}" Command="ScrollBar.PageUpCommand"/>
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                          <RepeatButton Style="{StaticResource RowsScrollPageButton}" Command="ScrollBar.PageDownCommand"/>
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                          <Thumb MinHeight="20" Focusable="False" IsTabStop="False">
                            <Thumb.Template>
                              <ControlTemplate TargetType="Thumb">
                                <Grid Background="Transparent" MinHeight="20">
                                  <Border Width="3" Background="#33E6E3EC" CornerRadius="1.5" HorizontalAlignment="Center"/>
                                </Grid>
                              </ControlTemplate>
                            </Thumb.Template>
                          </Thumb>
                        </Track.Thumb>
                      </Track>
                    </Grid>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Trigger>
          </Style.Triggers>
        </Style>
      </ScrollViewer.Resources>
      <StackPanel>
        <TextBlock x:Name="EmptyPending" Text="输入一件想完成的事" HorizontalAlignment="Center" Foreground="#91899E" FontSize="12" Margin="0,28,0,34"/>
        <StackPanel x:Name="PendingList"/>
        <Button x:Name="CompletedToggle" Visibility="Collapsed" HorizontalContentAlignment="Left" HorizontalAlignment="Left" Content="已完成" Foreground="#9F96AB" FontSize="11" Padding="2,7" Margin="0,7,0,0" ToolTip="展开或收起已完成任务"/>
        <StackPanel x:Name="CompletedList" Visibility="Collapsed"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Border>
